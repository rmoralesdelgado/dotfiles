# =============================================================================
# Brewfile.dev - Core CLI tools for development environments
# =============================================================================
# Used by: ./install.sh --dev
# Works on: macOS and Linux (via Linuxbrew)
#
# Essential terminal tools for a dev environment:
# devcontainers, cloud VMs, or local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Core utilities
# -----------------------------------------------------------------------------
brew "git"                  # Version control
brew "stow"                 # Dotfiles symlink manager
brew "make"                 # Build automation

# -----------------------------------------------------------------------------
# Modern CLI replacements
# -----------------------------------------------------------------------------
brew "eza"                  # Modern ls replacement
brew "bat"                  # Modern cat replacement (used by fzf previews)
brew "tree"                 # Directory tree visualization

# -----------------------------------------------------------------------------
# Shell & prompt
# -----------------------------------------------------------------------------
# Note: starship and zsh-completions are installed via zinit in .zshrc

# -----------------------------------------------------------------------------
# CLI applications
# -----------------------------------------------------------------------------
brew "gemini-cli"           # Gemini CLI
brew "gh"                   # GitHub CLI
brew "just"                 # Command runner (modern make alternative)
brew "tldr"                 # Simplified man pages